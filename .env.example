# Do not commit a real key. Run: python setup.py
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=openai,xai,deepseek
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
OPENAI_MODEL=gpt-6-astra
OPENAI_FALLBACK_MODELS=gpt-5.6-terra
XAI_MODEL=grok-4.7
XAI_FALLBACK_MODELS=grok-4.6
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODELS=deepseek-v4-pro
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Automatic fallback order if the primary model fails
AGENT_WORKSPACE=.
# Keep false for workspace-only mode. Set true to permit absolute paths and
# command working directories outside AGENT_WORKSPACE; confirmations remain on.
AGENT_HOST_MODE=false
# Colon-separated host-mode allowlist/denylist. Denylist wins.
# AGENT_ALLOWED_PATHS=/home/user/projects:/tmp
# AGENT_DENIED_PATHS=/home/user/.ssh:/home/user/.aws
AGENT_DRY_RUN=false
# Missing tools are resolved through installed/stdlib alternatives first.
SKILLS_ENABLED=true
# AGENT_SKILLS_PATH=./skills
AGENT_DEBUG=false
# Anti-spam pacing and retry controls
GEMINI_MIN_INTERVAL=0.2
GEMINI_RATE_LIMIT=30
GEMINI_RATE_WINDOW=60
GEMINI_BACKOFF_BASE=1
GEMINI_BACKOFF_MAX=16
GEMINI_PERSISTENT_LIMIT=300
GEMINI_PERSISTENT_WINDOW=86400
MAX_AGENT_STEPS=50
MAX_RETRIES=3
COMMAND_TIMEOUT=120
API_RETRIES=3
MAX_API_RESPONSE_BYTES=4194304
MAX_PROMPT_CHARS=16000
MAX_HISTORY_CHARS=12000
MAX_MEMORY_CHARS=3000
MAX_TOOL_RESULT_CHARS=5000
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=300
RESPONSE_CACHE_SIZE=128
TASK_TOOL_FILTERING=true
GEMINI_FAST_MODEL=gemini-flash-lite-latest
LOG_ROTATE_HOURS=24
LOG_RETENTION=7
REQUIRE_CONFIRMATION=true
# safe=plan/read-first, supervised=approval for protected actions, trusted=normal workspace edits without prompts
AUTONOMY_MODE=supervised
# Known-package install chain; keep false unless you explicitly want automatic installs.
AUTO_INSTALL=false
INSTALL_TIMEOUT=300
WEB_SEARCH_ENABLED=true
PLUGIN_ENABLED=true
MAX_PARALLEL_AGENTS=3
# AGENT_DB=~/.gemini_computer_agent.sqlite3
