# Do not commit a real key. Run: python setup.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Automatic fallback order if the primary model fails
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest
AGENT_WORKSPACE=.
MAX_AGENT_STEPS=50
MAX_RETRIES=3
COMMAND_TIMEOUT=120
API_RETRIES=3
MAX_API_RESPONSE_BYTES=4194304
MAX_PROMPT_CHARS=16000
MAX_HISTORY_CHARS=12000
MAX_MEMORY_CHARS=3000
MAX_TOOL_RESULT_CHARS=5000
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=300
RESPONSE_CACHE_SIZE=128
TASK_TOOL_FILTERING=true
GEMINI_FAST_MODEL=gemini-flash-lite-latest
LOG_ROTATE_HOURS=24
LOG_RETENTION=7
REQUIRE_CONFIRMATION=true
# AGENT_DB=~/.gemini_computer_agent.sqlite3
