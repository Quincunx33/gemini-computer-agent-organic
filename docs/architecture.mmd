flowchart LR
    U[User task] --> UI[Rich terminal UI\nagent.py]
    UI --> LOOP[Bounded agent loop\nagent_loop.py]
    LOOP --> GEM[Gemini REST client\ngemini_client.py]
    GEM --> PLAN[Structured tool planner\nplanner.py]
    PLAN --> PERM[Permission gate\npermissions.py]
    PERM --> TOOLS[Safe tool adapters]
    TOOLS --> TERM[Terminal & processes]
    TOOLS --> FS[Workspace filesystem]
    TOOLS --> WEB[Browser / GUI]
    TOOLS --> VERIFY[Verification]
    VERIFY --> LOOP
    LOOP --> MEM[(SQLite memory\nredacted summaries)]
    LOOP --> AUDIT[(Audit log\nsecrets redacted)]

    classDef user fill:#182338,stroke:#7dd3fc,color:#e0f2fe,stroke-width:2px;
    classDef core fill:#1e1b4b,stroke:#a78bfa,color:#ede9fe,stroke-width:2px;
    classDef safe fill:#172b25,stroke:#34d399,color:#d1fae5,stroke-width:2px;
    classDef store fill:#2b2117,stroke:#fbbf24,color:#fef3c7,stroke-width:2px;
    class U user;
    class UI,LOOP,GEM,PLAN core;
    class PERM,TOOLS,TERM,FS,WEB,VERIFY safe;
    class MEM,AUDIT store;
